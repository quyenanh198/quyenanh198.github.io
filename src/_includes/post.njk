---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    <h1>{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      · {{ content | readingTime }}
    </p>
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
