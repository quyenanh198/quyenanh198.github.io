---
layout: base.njk
---
<article class="post">
  <header class="post-header">
    <a class="back-link" href="/blog/">← All posts</a>
    <h1>{{ title }}</h1>
    <p class="post-meta">
      <time datetime="{{ date | htmlDateString }}">{{ date | readableDate }}</time>
      · {{ content | readingTime }}
    </p>
    {% if tags %}
    <ul class="tags">
      {% for tag in tags %}<li class="tag">{{ tag }}</li>{% endfor %}
    </ul>
    {% endif %}
  </header>
  <div class="prose">
    {{ content | safe }}
  </div>
</article>
